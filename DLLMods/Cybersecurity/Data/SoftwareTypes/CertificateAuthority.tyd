					Script_EndOfDay	"if (Product.GetVar(\"RubberStamp\", true)) { if (Random() * Product.Userbase > 600000 * Product.Category.Popularity) { LaunchLawsuit(\"MisissuedCertificates\", Product.Sum * 1.5, 0.7); Product.DevCompany.AddFans(-Product.Userbase * 0.6, Product.Category); Product.ChangeUserbase(Product.Userbase * 0.1); Product.KillAwareness(); Product.PutVar(\"RubberStamp\", false); AddPopup(Localize(\"RubberStampNotification\", Product.Name), 1, \"Exclamation\", Issue); } }"
					Script_AfterSales	"if (Product.GetVar(\"RubberStamp\", true)) { Product.DevCompany.MakeTransaction((PhysicalSales + DigitalSales) * 20, Deals, \"Bulk Issuance Fees\"); }"
				}
